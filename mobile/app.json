{
  "expo": {
    "name": "Sparq",
    "slug": "sparq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "sparq",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sparq.dating",
      "infoPlist": {
        "NSCameraUsageDescription": "Sparq needs camera access for profile photos and video calls.",
        "NSPhotoLibraryUsageDescription": "Sparq needs photo library access to upload profile pictures.",
        "NSMicrophoneUsageDescription": "Sparq needs microphone access for voice and video calls.",
        "NSLocationWhenInUseUsageDescription": "Sparq uses your location to find matches near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.sparq.dating",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF3D6B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sparq to access your photos."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
