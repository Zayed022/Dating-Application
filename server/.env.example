# ─── SERVER ENVIRONMENT ───────────────────────────────────────────────────────
# Copy this file to server/.env for local dev
# In Render Dashboard → Environment, paste each key/value individually

PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# IMPORTANT: After this session, rotate your password at atlas.mongodb.com
# Go to: Database Access → Edit User → Edit Password
MONGODB_URI=mongodb+srv://zayedans088_db_user:YOUR_NEW_PASSWORD@cluster0.oagvfbl.mongodb.net/sparq?retryWrites=true&w=majority&appName=Cluster0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# CRITICAL: These two MUST be different strings. Use a random generator:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING_A
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING_B
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# IMPORTANT: After this session, regenerate API secret at cloudinary.com
# Go to: Settings → Access Keys → Generate New Pair
CLOUDINARY_CLOUD_NAME=dlgwqmlsj
CLOUDINARY_API_KEY=615572412342563
CLOUDINARY_API_SECRET=REPLACE_WITH_YOUR_NEW_SECRET

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Sign up at razorpay.com → Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Expo Push Notifications (Server side) ────────────────────────────────────
# Get from: expo.dev → Account Settings → Access Tokens → Create Token
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# ─── Render (auto-provided, do NOT set manually in Render dashboard) ──────────
# RENDER_EXTERNAL_URL is injected automatically by Render into your service
# It will look like: https://sparq-backend.onrender.com
# The keep-alive ping uses this automatically — no action needed
